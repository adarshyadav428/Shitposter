# Shitposter cron jobs — install with: crontab -e
# Adjust docker compose project path as needed.

# Nightly shadowban probe (9 PM UTC) for each X account
0 21 * * * docker compose -f /opt/shitposter/docker-compose.yml run --rm app python -m scripts.shadowban_probe your_x_handle >> /var/log/shitposter/shadowban.log 2>&1

# Weekly retraction audit (Monday 9 AM UTC)
0 9 * * 1 docker compose -f /opt/shitposter/docker-compose.yml run --rm app python -m scripts.retraction_audit >> /var/log/shitposter/audit.log 2>&1

# Monthly X budget reset reminder (1st of month, 8 AM UTC)
0 8 1 * * echo "Shitposter: new X write month. Budget reset to $(docker compose -f /opt/shitposter/docker-compose.yml run --rm -T app python -c 'from src.config import get_settings; print(get_settings().x_monthly_write_budget)') writes." | mail -s "Shitposter monthly budget" ops@yourdomain.com 2>/dev/null || true
