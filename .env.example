APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000

DATABASE_URL=sqlite:///./newsbot.db
REDIS_URL=redis://localhost:6379/0

ANTHROPIC_API_KEY=

X_ENABLED=false
X_MONTHLY_BUDGET=40
X_CORRECTION_BUDGET=10
X_MIN_GAP_MINUTES=45
X_ACCOUNT_CREATED_AT=2026-01-01T00:00:00Z
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

TELEGRAM_ENABLED=false
BLUESKY_ENABLED=false
MASTODON_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
BLUESKY_IDENTIFIER=
BLUESKY_APP_PASSWORD=
MASTODON_BASE_URL=
MASTODON_ACCESS_TOKEN=

USE_MOCK_INGESTORS=true
ENABLE_REAL_RSS=true
POLL_INTERVAL_SECONDS=30
AUTOPILOT_ENABLED=true
ENABLE_STATE_SNAPSHOT=true
STATE_BACKEND=json
STATE_SNAPSHOT_PATH=.state/newsbot_state.json
STATE_SQLITE_PATH=.state/newsbot_state.sqlite
RETRACTION_MONITOR_ENABLED=true
RETRACTION_MONITOR_INTERVAL_SECONDS=300
HEARTBEAT_ENABLED=false
HEARTBEAT_INTERVAL_SECONDS=300
ENFORCE_STARTUP_PREFLIGHT=true
ADMIN_API_TOKEN=
RETENTION_ENABLED=true
RETENTION_MAX_EVENTS=5000
RETENTION_MAX_PUBLICATIONS=10000
RETENTION_MAX_FAILED_PUBLICATIONS=5000
RETENTION_MAX_DROP_SAMPLES=10000

GLOBAL_PAUSE=false
