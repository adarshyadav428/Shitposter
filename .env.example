APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000

DATABASE_URL=sqlite:///./newsbot.db
REDIS_URL=redis://localhost:6379/0

ANTHROPIC_API_KEY=

X_ENABLED=false
X_MONTHLY_BUDGET=40
X_CORRECTION_BUDGET=10
X_MIN_GAP_MINUTES=45
X_ACCOUNT_CREATED_AT=2026-01-01T00:00:00Z

TELEGRAM_ENABLED=false
BLUESKY_ENABLED=false
MASTODON_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
BLUESKY_IDENTIFIER=
BLUESKY_APP_PASSWORD=
MASTODON_BASE_URL=
MASTODON_ACCESS_TOKEN=

USE_MOCK_INGESTORS=true
ENABLE_REAL_RSS=true
POLL_INTERVAL_SECONDS=30
AUTOPILOT_ENABLED=true
ENABLE_STATE_SNAPSHOT=true
STATE_SNAPSHOT_PATH=.state/newsbot_state.json
RETRACTION_MONITOR_ENABLED=true
RETRACTION_MONITOR_INTERVAL_SECONDS=300
ADMIN_API_TOKEN=

GLOBAL_PAUSE=false
